{
  "manifest_version": 2,
  "version": "1.1.3",
  "id": "github.elmeir.gif-storyboard",
  "name": "GIF 动图分镜（视觉增强）",
  "description": "在麦麦把 GIF 动图交给视觉模型之前，把动画的各帧按时序均匀抽取（分段清晰度选帧，避开运动模糊）并合成到同一张网格静态图上（可绘制帧序号），让视觉模型能看到动画的完整内容与时序，而不是只看到第一帧。只处理 GIF 魔数的多帧动图；普通图片采用替换+落库前恢复模式——识别窗口内以合成图参与视觉识别，落库与聊天记录按原图保真；帧数可按动画运动量自适应调节。表情包可选旁路识别/直接替换/不处理。挂载 chat.receive.before_process 与 chat.receive.after_process 钩子，宿主识别链路自动生效，不改宿主一行代码。",
  "author": {
    "name": "Elmeir",
    "url": "https://github.com/Elmeir"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Elmeir/maibot-plugin-gif-storyboard",
    "homepage": "https://github.com/Elmeir/maibot-plugin-gif-storyboard",
    "documentation": "https://github.com/Elmeir/maibot-plugin-gif-storyboard#readme",
    "issues": "https://github.com/Elmeir/maibot-plugin-gif-storyboard/issues"
  },
  "host_application": {
    "min_version": "1.2.4",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "database.query"
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎞️"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
